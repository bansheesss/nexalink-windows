[Unit]
Description=RemoteLink relay
After=network-online.target

[Service]
User=remotelink
WorkingDirectory=/opt/remotelink
Environment=RELAY_TOKEN=change-me
ExecStart=/usr/bin/python3 -m relay --port 7072 --registry /var/lib/remotelink/registry.json
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/remotelink

[Install]
WantedBy=multi-user.target

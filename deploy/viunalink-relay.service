[Unit]
Description=ViunaLink Relay Server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=viunalink
Group=viunalink
WorkingDirectory=/opt/viunalink
EnvironmentFile=/etc/viunalink/relay.env
ExecStart=/opt/viunalink/.venv/bin/python -m relay --host 0.0.0.0 --port 7072 --registry /var/lib/viunalink/registry.json --cert /etc/viunalink/tls/fullchain.pem --key /etc/viunalink/tls/privkey.pem
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/viunalink

[Install]
WantedBy=multi-user.target

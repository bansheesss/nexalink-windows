[Unit]
Description=ViunaLink relay service
After=network-online.target

[Service]
User=viunalink
WorkingDirectory=/opt/viunalink
Environment=RELAY_TOKEN=change-me
ExecStart=/usr/bin/python3 -m relay --port 7072 --registry /var/lib/viunalink/registry.json
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/viunalink

[Install]
WantedBy=multi-user.target
